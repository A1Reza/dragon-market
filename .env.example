# Backend-only local setup. The workbench script uses explicit loopback defaults.
DATABASE_URL=postgres://market:market@127.0.0.1:5432/market?sslmode=disable
PRICE_ORACLE_URL=http://127.0.0.1:8090
HTTP_ADDR=127.0.0.1:8080
# Omit APP_ENV for the default backend without diagnostic routes.
APP_ENV=development
# Only for the separate local Testcontainers runner:
RESEARCH_LAB=1
# workbench.mjs selects a separate host port to avoid existing PostgreSQL services.
WORKBENCH_DB_PORT=15432
# Standalone Compose defaults to POSTGRES_PORT=5432.
